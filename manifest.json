{
  "manifest_version": 3,
  "name": "WAB Ext",
  "version": "1.0",
  "description": "WhatsApp Web automation extension for accessibility",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["whatsapp.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wab-ext@local.dev",
      "strict_min_version": "109.0"
    }
  }
}