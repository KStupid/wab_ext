1, send button 
	accessing the button send = document.querySelector('button[aria-label="Send"]');
	to click the element so as to send the message = document.querySelector('button[aria-label="Send"]').click(); 
	
	or
	document.querySelector('span[data-icon="wds-ic-send-filled"]').closest('button');

2, text area	
	acessing the text area 
		document.querySelector('div[data-testid="conversation-compose-box-input"][contenteditable="true"]')
		or 
		document.querySelector('div[data-testid="conversation-compose-box-input"])
		or 
		document.querySelector('div[role="textbox"][contenteditable="true"][aria-placeholder="Type a message"]')

3, chat search box 
	document.querySelector('input[aria-label="Search or start a new chat"]')
	or 
	document.querySelector('input[placeholder="Search or start a new chat"]')
	or
	document.querySelector('input[role="textbox"][aria-label="Search or start a new chat"]')
