(async function demoWhatsAppAutomation() {
    const PHONE_NUMBER = "9495342265";
    const MESSAGE_TEXT = "Hello! This is an automated test message.";

    console.log("🚀 Starting DOM automation script...");

    const find = (selector) => document.querySelector(selector);
    const waitFor = (selector, ms = 5000) => new Promise(res => {
        const el = find(selector);
        if (el) return res(el);
        const obs = new MutationObserver(() => {
            const found = find(selector);
            if (found) { obs.disconnect(); res(found); }
        });
        obs.observe(document.body, { childList: true, subtree: true });
        setTimeout(() => { obs.disconnect(); res(null); }, ms);
    });

    const sleep = (ms) => new Promise(res => setTimeout(res, ms));

    // STEP 1: Click New Chat Button
    const newChatBtn = (
        find('span[data-testid="new-chat-outline"]')?.closest('button') ||
        find('span[data-icon="new-chat-outline"]')?.closest('button') ||
        find('div[title="New chat"]')?.closest('button')
    );
    if (!newChatBtn) return console.error("❌ Step 1 Failed: New Chat button not found.");
    newChatBtn.click();
    console.log("✅ 1. Clicked 'New Chat'");

    // STEP 2: Find Search Input
    const searchInp = await waitFor('input[aria-label="Search name or number"], input[role="textbox"]');
    if (!searchInp) return console.error("❌ Step 2 Failed: Search input not found.");

    // STEP 2a: Enter Phone Number
    searchInp.focus();
    const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value").set;
    setter.call(searchInp, PHONE_NUMBER);
    
    // Dispatch React input events
    searchInp.dispatchEvent(new InputEvent("input", { bubbles: true, inputType: "insertText", data: PHONE_NUMBER }));
    console.log(`✅ 2. Entered phone number: ${PHONE_NUMBER}`);

    await sleep(1000); // Allow search results to render

    // STEP 3: Press Enter Key to select chat
    searchInp.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", code: "Enter", keyCode: 13, which: 13, bubbles: true }));
    console.log("✅ 3. Pressed Enter to select chat");

    // STEP 4: Write Message in Compose Box
    const composeBox = await waitFor('div[contenteditable="true"][data-tab="10"], div[contenteditable="true"][aria-placeholder*="Type a message"]', 6000);
    if (!composeBox) return console.error("❌ Step 4 Failed: Message compose box not found.");

    composeBox.focus();
    
    // Use execCommand followed by InputEvent to satisfy Lexical state
    document.execCommand("insertText", false, MESSAGE_TEXT);
    composeBox.dispatchEvent(new InputEvent("input", { bubbles: true, inputType: "insertText", data: MESSAGE_TEXT }));
    
    console.log("✅ 4. Inserted message text");

    await sleep(500); // Wait for Send button to trigger render from React state change

    // STEP 5: Click Send Button or Press Enter in Compose Box
    const sendBtn = (
        find('button[aria-label="Send"]') ||
        find('span[data-icon="send"]')?.closest('button') ||
        find('span[data-icon="wds-ic-send-filled"]')?.closest('button')
    );

    if (sendBtn) {
        sendBtn.click();
        console.log("🎉 5. Clicked Send button! Message sent successfully.");
    } else {
        console.warn("⚠️ Send button not visible. Falling back to KeyboardEvent Enter submission...");
        composeBox.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", code: "Enter", keyCode: 13, which: 13, bubbles: true }));
        console.log("🎉 5. Dispatched Enter key event to compose box.");
    }
})();